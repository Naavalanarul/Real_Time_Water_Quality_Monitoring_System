/*
  IoT Water Quality Monitoring System — ESP32
  Sensors: Turbidity (analog), TDS (analog), pH-4502C module (analog PO), DS18B20 (digital, 1-Wire)
  Output: JSON payload published via MQTT over WiFi, every 5 minutes

  BEFORE YOU RUN THIS:
  1. Fill in your WiFi SSID/password and MQTT broker IP below.
  2. Run the CALIBRATION section instructions (bottom of file) BEFORE trusting turbidity/TDS/pH values.
     The conversion formulas below are PLACEHOLDERS — flagged clearly — because they depend on
     your exact sensor module and cannot be given as universal constants.
  3. Confirm your board is on ADC1 pins (32-39) as wired — required because ADC2 conflicts with WiFi.

  Libraries required (install via Arduino IDE Library Manager):
  - OneWire
  - DallasTemperature
  - PubSubClient
  - ArduinoJson (v6.x)
*/

#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <time.h>

// ---------------- USER CONFIG — EDIT THESE ----------------
const char* WIFI_SSID     = "S24";
const char* WIFI_PASSWORD = "asdfgqwerty";

const char* MQTT_SERVER   = "10.121.231.14"; // e.g. "192.168.1.50" for local Mosquitto
const int   MQTT_PORT     = 1883;
const char* MQTT_TOPIC    = "waterquality/site1";
const char* MQTT_CLIENT_ID = "esp32_Station_01"; // used as both MQTT client ID and device_id in the JSON payload — change to your actual station naming convention

// NTP (for real-world timestamps, not just millis())
const char* NTP_SERVER    = "pool.ntp.org";
const long  GMT_OFFSET_SEC = 5 * 3600 + 1800; // IST = UTC+5:30. Change if deploying elsewhere.
const int   DAYLIGHT_OFFSET_SEC = 0;

// Sampling interval
const unsigned long SAMPLE_INTERVAL_MS = 1UL * 10UL * 1000UL; // 1 minutes
// ------------------------------------------------------------

// ---------------- PIN DEFINITIONS ----------------
#define TURBIDITY_PIN   34   // ADC1_CH6
#define TDS_PIN         35   // ADC1_CH7
#define PH_PIN          32   // ADC1_CH4
#define ONE_WIRE_BUS    4    // DS18B20 data pin

const float ADC_VREF = 3.3;
const int   ADC_RESOLUTION = 4095; // 12-bit ADC

// ---------------- CALIBRATION PLACEHOLDERS ----------------
// FLAG: These are NOT verified universal constants. You must determine them
// experimentally for YOUR exact sensor module, as discussed earlier.
// Leaving these unset (as-is) will produce readings that LOOK plausible but
// are not accurate. Do not treat output as valid until this section is done.

// --- pH calibration (two-point, using pH 4 and pH 7 buffer solutions) ---
// Steps: dip probe in pH7 buffer, note voltage (V7). Dip in pH4 buffer, note voltage (V4).
// Slope = (7 - 4) / (V7 - V4)  ->  pH = 7 + slope * (V_measured - V7)
float PH_V7 = 1;   // PLACEHOLDER — replace with your measured voltage at pH 7
float PH_V4 = 0.823;   // PLACEHOLDER — replace with your measured voltage at pH 4

// --- TDS calibration ---
// FLAG: I am not providing a generic voltage->ppm formula. Different TDS modules
// use different reference formulas (some datasheets include temperature compensation
// terms). Get the exact formula from YOUR module's datasheet before relying on tds_ppm.
// Below is a placeholder linear scale ONLY — replace with your module's actual formula.
float TDS_SCALE_FACTOR = 133.42; // PLACEHOLDER — arbitrary example, not a verified constant

// --- Turbidity calibration (two-point: 0 NTU distilled water, known NTU standard) ---
// Steps: read voltage in distilled water (V_clear, ~0 NTU). Read voltage in a known
// turbidity standard solution (V_standard, known NTU value). Compute linear scale below.
float TURBIDITY_V_CLEAR = 3.00;      // PLACEHOLDER — voltage in ~0 NTU water
float TURBIDITY_NTU_AT_V_CLEAR = 0.0;
float TURBIDITY_V_STANDARD = 2.20;   // PLACEHOLDER — voltage in known-NTU standard
float TURBIDITY_NTU_AT_STANDARD = 100.0; // PLACEHOLDER — replace with your standard's actual NTU

// ------------------------------------------------------------

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature tempSensor(&oneWire);

WiFiClient espClient;
PubSubClient client(espClient);

unsigned long lastSampleTime = 0;

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);
  delay(1000);

  tempSensor.begin();

  setupWiFi();
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER);
  waitForTimeSync();

  client.setServer(MQTT_SERVER, MQTT_PORT);

  Serial.println("Setup complete. Starting sampling loop.");
}

// ---------------- MAIN LOOP ----------------
void loop() {
  if (!client.connected()) {
    reconnectMQTT();
  }
  client.loop();

  if (millis() - lastSampleTime >= SAMPLE_INTERVAL_MS || lastSampleTime == 0) {
    lastSampleTime = millis();
    takeSampleAndPublish();
  }
}

// ---------------- WIFI ----------------
void setupWiFi() {
  Serial.print("Connecting to WiFi: ");
  Serial.println(WIFI_SSID);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long startAttempt = millis();
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    // Basic timeout guard — retries indefinitely in this simple version,
    // but you may want to add a hard reset after N failed attempts for
    // unattended field deployment.
  }
  Serial.println();
  Serial.print("WiFi connected. IP: ");
  Serial.println(WiFi.localIP());
}

void waitForTimeSync() {
  Serial.print("Waiting for NTP time sync");
  time_t now = time(nullptr);
  int attempts = 0;
  while (now < 100000 && attempts < 20) { // crude check: epoch time not yet valid
    delay(500);
    Serial.print(".");
    now = time(nullptr);
    attempts++;
  }
  Serial.println();
  if (now < 100000) {
    Serial.println("WARNING: NTP sync failed. Timestamps will be inaccurate.");
  } else {
    Serial.println("Time synced.");
  }
}

// ---------------- MQTT ----------------
void reconnectMQTT() {
  while (!client.connected()) {
    Serial.print("Connecting to MQTT broker...");
    if (client.connect(MQTT_CLIENT_ID)) {
      Serial.println("connected.");
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" retrying in 2s");
      delay(2000);
    }
  }
}

// ---------------- SENSOR READ FUNCTIONS ----------------

float readTemperatureC() {
  tempSensor.requestTemperatures();
  float t = tempSensor.getTempCByIndex(0);
  if (t == DEVICE_DISCONNECTED_C) {
    Serial.println("WARNING: DS18B20 not detected / read error.");
    return NAN;
  }
  return t;
}

float readPHVoltage() {
  int raw = analogRead(PH_PIN);
  return raw * (ADC_VREF / ADC_RESOLUTION);
}

float voltageToPH(float voltage) {
  // Linear two-point calibration using PH_V7 / PH_V4 above.
  // FLAG: accuracy depends entirely on how carefully you did the buffer calibration.
  float slope = (7.0 - 4.0) / (PH_V7 - PH_V4);
  float ph = 7.0 + slope * (voltage - PH_V7);
  return ph;
}

float readTDSVoltage() {
  int raw = analogRead(TDS_PIN);
  return raw * (ADC_VREF / ADC_RESOLUTION);
}

float voltageToTDS(float voltage, float temperatureC) {
  // PLACEHOLDER FORMULA — FLAG: replace with your module's actual datasheet formula.
  // This simple linear scale is NOT verified against any specific sensor's real behavior
  // and does not include proper temperature compensation. Do not treat this as accurate
  // until you've substituted the real formula from your module's documentation.
  float compensationCoefficient = 1.0 + 0.02 * (temperatureC - 25.0); // common general form, NOT verified for your module
  float compensatedVoltage = voltage / compensationCoefficient;
  float tds = compensatedVoltage * TDS_SCALE_FACTOR;
  return tds; // ppm — placeholder scale, calibrate before trusting
}

float readTurbidityVoltage() {
  int raw = analogRead(TURBIDITY_PIN);
  return raw * (ADC_VREF / ADC_RESOLUTION);
}

float voltageToNTU(float voltage) {
  // Linear two-point calibration using TURBIDITY_V_CLEAR / TURBIDITY_V_STANDARD above.
  float slope = (TURBIDITY_NTU_AT_STANDARD - TURBIDITY_NTU_AT_V_CLEAR) /
                (TURBIDITY_V_STANDARD - TURBIDITY_V_CLEAR);
  float ntu = TURBIDITY_NTU_AT_V_CLEAR + slope * (voltage - TURBIDITY_V_CLEAR);
  if (ntu < 0) ntu = 0; // clamp — turbidity can't be negative
  return ntu;
}

// ---------------- SAMPLE + PUBLISH ----------------
void takeSampleAndPublish() {
  float temperature = readTemperatureC();

  float phVoltage = readPHVoltage();
  Serial.print("pH raw voltage: ");
  Serial.println(phVoltage, 4);
  float ph = voltageToPH(phVoltage);

  float tdsVoltage = readTDSVoltage();
  float tds = voltageToTDS(tdsVoltage, isnan(temperature) ? 25.0 : temperature);

  float turbidityVoltage = readTurbidityVoltage();
  Serial.print("Turbidity raw voltage: ");
Serial.println(turbidityVoltage, 4);
  float turbidity = voltageToNTU(turbidityVoltage);

  time_t now = time(nullptr);

  // JSON structure matches the frontend/backend's required schema:
  // { "device_id": ..., "timestamp": <epoch>, "sensors": { "pH", "turbidity", "temperature_c", "tds_ppm" } }
  StaticJsonDocument<300> doc;
  doc["device_id"] = MQTT_CLIENT_ID;
  doc["timestamp"] = (unsigned long)now; // Unix epoch seconds, matches your sample's format

  JsonObject sensors = doc.createNestedObject("sensors");
  sensors["pH"] = ph;
  sensors["turbidity"] = turbidity;
  sensors["temperature_c"] = isnan(temperature) ? 0.0 : (double)temperature; // FLAG: using 0.0 as fallback since your schema has no null-handling shown — change if your backend expects null/omitted key instead
  sensors["tds_ppm"] = tds;

  char buffer[300];
  size_t n = serializeJson(doc, buffer);

  Serial.print("Publishing: ");
  Serial.println(buffer);

  bool ok = client.publish(MQTT_TOPIC, buffer, n);
  if (!ok) {
    Serial.println("WARNING: MQTT publish failed.");
  }
}

/*
  ---------------- CALIBRATION PROCEDURE (do this before trusting data) ----------------

  pH:
    1. Rinse probe in distilled water.
    2. Dip in pH 7.00 buffer solution, let reading stabilize, note voltage from Serial monitor
       (print phVoltage temporarily if needed).
    3. Rinse, dip in pH 4.00 buffer, note voltage.
    4. Set PH_V7 and PH_V4 above to your two measured values. Re-upload.

  TDS:
    1. Get your sensor module's actual datasheet formula — do not rely on the placeholder above.
    2. Test in a known-concentration reference solution (e.g., a labeled NaCl calibration
       solution) and adjust TDS_SCALE_FACTOR (or replace the whole formula) to match.

  Turbidity:
    1. Read voltage in distilled/clear water (~0 NTU) — set TURBIDITY_V_CLEAR.
    2. Read voltage in a known turbidity standard solution — set TURBIDITY_V_STANDARD and
       TURBIDITY_NTU_AT_STANDARD to that solution's actual labeled NTU value.

  Temperature (DS18B20):
    Factory calibrated to ~±0.5°C typically. Optionally cross-check against a known-accurate
    thermometer once; this is not something I can confirm for your specific unit.

  ---------------------------------------------------------------------------------------
*/
